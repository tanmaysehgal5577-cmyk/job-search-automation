# Copy to .env and edit. Never commit the real .env file.

# --- Target sites ---
BASE_URL=https://realpython.github.io/fake-jobs/
FORM_URL=https://httpbin.org/forms/post

# --- Browser ---
BROWSER=chromium          # chromium | firefox | webkit
HEADLESS=true
SLOW_MO_MS=0              # slow actions down (ms) to watch them in headed mode
TIMEOUT_MS=30000
MAX_RETRIES=3
RETRY_DELAY_S=1
DETAIL_CONCURRENCY=5      # parallel detail pages when using --details

# --- Paths & logging ---
OUTPUT_DIR=output
SCREENSHOT_DIR=screenshots
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Used only by the `apply` command ---
APPLICANT_NAME=
APPLICANT_EMAIL=
APPLICANT_PHONE=
